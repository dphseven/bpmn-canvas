{
  "name": "bpmn-canvas",
  "version": "1.2.0",
  "description": "A lightweight, zero-dependency workflow canvas and diagram modeler inspired by BPMN 2.0, built with native DOM + SVG architecture.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:types": "tsc -p tsconfig.json",
    "typecheck:types": "tsc --noEmit --ignoreConfig --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler types/index.d.ts",
    "prepublishOnly": "npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dphseven/bpmn-canvas.git"
  },
  "keywords": [
    "bpmn",
    "bpmn-canvas",
    "workflow",
    "workflow-canvas",
    "diagram",
    "diagramming",
    "graph",
    "flowchart",
    "process-modeling",
    "svg",
    "zero-dependencies"
  ],
  "author": "Don Hussey",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/dphseven/bpmn-canvas/issues"
  },
  "homepage": "https://github.com/dphseven/bpmn-canvas#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
